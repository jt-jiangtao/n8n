{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-desk.local/schemas/project-workflow.schema.json",
  "title": "ProjectWorkflowConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^/"
    },
    "baseRef": {
      "type": "string",
      "minLength": 1
    },
    "flows": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argv": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command"
        ]
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "readyPath": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "loginCommandRef": {
            "type": "string",
            "minLength": 1
          },
          "existingUrl": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "command"
            ],
            "not": {
              "required": [
                "existingUrl"
              ]
            }
          },
          {
            "required": [
              "existingUrl"
            ],
            "not": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "commands",
        "services"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandRef": {
            "type": "string",
            "minLength": 1
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "exit-code",
                  "junit",
                  "json"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "format"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "compareWithBase": {
            "type": "boolean"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "regression": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "files"
            ]
          }
        },
        "required": [
          "commandRef",
          "report"
        ]
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "legacyArea": {
      "type": "string"
    },
    "actionDriverMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 5
        }
      },
      "required": [
        "command",
        "args"
      ]
    }
  },
  "required": [
    "version",
    "projectId",
    "name",
    "repo",
    "baseRef",
    "flows",
    "prompts",
    "skills",
    "schemas",
    "preparation",
    "verification",
    "roles"
  ]
}
