{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-desk.local/schemas/human-step-params.schema.json",
  "title": "HumanStepParams",
  "description": "Flow Desk Human Step 节点参数",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "assigneeRole"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "assigneeRole": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "requiresText": {
      "type": "boolean",
      "description": "必须附文字回答才能提交"
    },
    "freezeAcceptance": {
      "type": "boolean",
      "description": "确认后冻结验收标准"
    },
    "waitHours": { "type": "number", "minimum": 0 }
  }
}
