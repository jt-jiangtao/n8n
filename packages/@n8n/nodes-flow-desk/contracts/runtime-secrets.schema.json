{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-desk.local/schemas/runtime-secrets.schema.json",
  "title": "RuntimeSecrets",
  "description": "运行时密钥目录中结构化文件的格式（plane.json / agent-credentials）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "planeJson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowDesk", "agentBot"],
      "properties": {
        "flowDesk": { "type": "string", "minLength": 1 },
        "agentBot": { "type": "string", "minLength": 1 }
      }
    },
    "agentCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursorApiKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
