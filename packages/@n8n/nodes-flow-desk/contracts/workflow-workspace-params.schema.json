{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-desk.local/schemas/workflow-workspace-params.schema.json",
  "title": "WorkflowWorkspaceParams",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repoRef": { "enum": ["project", "project-config"] },
    "baseRef": {
      "type": "string"
    },
    "target": {
      "enum": ["base", "integration"]
    },
    "operation": {
      "enum": ["prepare", "revert", "assemble"]
    },
    "revertRef": {
      "type": "string",
      "minLength": 1
    },
    "childrenRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "revert"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["revertRef"]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "assemble"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["childrenRef"]
      }
    }
  ]
}
